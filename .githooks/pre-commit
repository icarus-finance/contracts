#!/bin/sh
set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo"
if [ ! -x node_modules/.bin/prettier ]; then
    echo 'Install dependencies with yarn --frozen-lockfile before committing.' >&2
    exit 1
fi
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/icarus-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM

# Check exactly what will be committed, including config and package scripts.
git checkout-index --all --prefix="$snapshot/"
ln -s "$repo/node_modules" "$snapshot/node_modules"
cd "$snapshot"
if ! yarn format:check; then
    echo 'Formatting failed. Run yarn format, review and stage the fixes, then retry.' >&2
    exit 1
fi
